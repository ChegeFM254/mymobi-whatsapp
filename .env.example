PORT=3000
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=mymobi_test_123

# Optional for now. Find this in Meta App Dashboard -> App Settings ->
# Basic -> App Secret (different from your access token above). Enables
# webhook signature verification, which confirms incoming requests
# genuinely came from Meta/WhatsApp rather than an imposter. Leaving
# this unset does NOT block testing - the app will run fine without it,
# just with a startup warning reminding you it's not set yet.
WHATSAPP_APP_SECRET=

# Optional. The public URL Payslip/Loan Statement/Loan Clearance document
# links point to. Render usually provides RENDER_EXTERNAL_URL
# automatically, but that isn't guaranteed on every plan — set this
# explicitly once you know your real Render URL, e.g.
# https://mymobi-whatsapp.onrender.com
PUBLIC_BASE_URL=

# Controls whether Log In accepts UPN+PIN for a WhatsApp number with no
# stored local record (see verifyLoginCredentials in the code). Defaults
# to true (bypass ON) so testing isn't blocked by the in-memory-storage
# data loss issue. Set to "false" for UAT/Production, once a real
# backend exists, to require genuine stored data for login again.
ALLOW_LOGIN_WITHOUT_STORED_DATA=true
